{
  "StartAt": "HandleConfigError",
  "States": {
    "HandleConfigError": {
      "Type": "Choice",
      "InputPath": "$",
      "Choices": [
        {
          "Variable": "$.stateMachine.statusCode",
          "NumericEquals": 200,
          "Next": "CheckComputeType"
        }
      ],
      "Default": "FailState"
    },
    "CheckComputeType": {
      "Type": "Choice",
      "InputPath": "$",
      "Choices": [
        {
          "Variable": "$.envVars.USE_SPOT_INSTANCE",
          "StringEquals": "true",
          "Next": "SetDefaultJobDefinition"
        }
      ],
      "Default": "InvokeSageMakerWorkflow"
    },

    "SetDefaultJobDefinition": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName.$": "$.stateMachine.jobDefinitionSelectorLambdaName",
        "Payload.$": "$"
      },
      "OutputPath": "$.Payload",
      "Next": "InvokeBatchWorkflow"
    },
    "InvokeBatchWorkflow": {
      "Type": "Task",
      "InputPath": "$",
      "ResultPath": "$.invokeWorkflow",
      "Resource": "arn:aws:states:::batch:submitJob.sync",
      "Parameters": {
        "JobName.$": "$.envVars.UUID",
        "JobQueue.$": "$.selectedBatchJobQueue",
        "JobDefinition.$": "$.selectedBatchJobDefinition",
        "ContainerOverrides": {
          "Environment": [
            {"Name": "UUID", "Value.$": "$.envVars.UUID"},
            {"Name": "DATA_CHANNEL", "Value.$": "$.envVars.DATA_CHANNEL"},
            {"Name": "MODEL_INPUT", "Value.$": "$.envVars.MODEL_INPUT"},
            {"Name": "S3_INPUT", "Value.$": "$.envVars.S3_INPUT"},
            {"Name": "S3_OUTPUT", "Value.$": "$.envVars.S3_OUTPUT"},
            {"Name": "FILENAME", "Value.$": "$.envVars.FILENAME"},
            {"Name": "INSTANCE_TYPE", "Value.$": "$.envVars.INSTANCE_TYPE"},
            {"Name": "USE_SPOT_INSTANCE", "Value.$": "$.envVars.USE_SPOT_INSTANCE"},
            {"Name": "COMPUTE_TYPE", "Value.$": "$.envVars.COMPUTE_TYPE"},
            {"Name": "LOG_VERBOSITY", "Value.$": "$.envVars.LOG_VERBOSITY"},
            {"Name": "MAX_NUM_IMAGES", "Value.$": "$.envVars.MAX_NUM_IMAGES"},
            {"Name": "VIDEO_START_TIME", "Value.$": "$.envVars.VIDEO_START_TIME"},
            {"Name": "VIDEO_STOP_TIME", "Value.$": "$.envVars.VIDEO_STOP_TIME"},
            {"Name": "FILTER_BLURRY_IMAGES", "Value.$": "$.envVars.FILTER_BLURRY_IMAGES"},
            {"Name": "RUN_RECON", "Value.$": "$.envVars.RUN_RECON"},
            {"Name": "RECON_SOFTWARE_NAME", "Value.$": "$.envVars.RECON_SOFTWARE_NAME"},
            {"Name": "USE_POSE_PRIOR_COLMAP_MODEL_FILES", "Value.$": "$.envVars.USE_POSE_PRIOR_COLMAP_MODEL_FILES"},
            {"Name": "USE_POSE_PRIOR_TRANSFORM_JSON", "Value.$": "$.envVars.USE_POSE_PRIOR_TRANSFORM_JSON"},
            {"Name": "SOURCE_COORD_NAME", "Value.$": "$.envVars.SOURCE_COORD_NAME"},
            {"Name": "POSE_IS_WORLD_TO_CAM", "Value.$": "$.envVars.POSE_IS_WORLD_TO_CAM"},
            {"Name": "ENABLE_ENHANCED_FEATURE_EXTRACTION", "Value.$": "$.envVars.ENABLE_ENHANCED_FEATURE_EXTRACTION"},
            {"Name": "MATCHING_METHOD", "Value.$": "$.envVars.MATCHING_METHOD"},
            {"Name": "ENABLE_FL_HEURISTIC", "Value.$": "$.envVars.ENABLE_FL_HEURISTIC"},
            {"Name": "FL_HEURISTIC_VALUE", "Value.$": "$.envVars.FL_HEURISTIC_VALUE"},
            {"Name": "RUN_TRAIN", "Value.$": "$.envVars.RUN_TRAIN"},
            {"Name": "MODEL", "Value.$": "$.envVars.MODEL"},
            {"Name": "MAX_STEPS", "Value.$": "$.envVars.MAX_STEPS"},
            {"Name": "THREED_ISP", "Value.$": "$.envVars.THREED_ISP"},
            {"Name": "ENABLE_SPZ", "Value.$": "$.envVars.ENABLE_SPZ"},
            {"Name": "ENABLE_SOG", "Value.$": "$.envVars.ENABLE_SOG"},
            {"Name": "ENABLE_USDZ", "Value.$": "$.envVars.ENABLE_USDZ"},
            {"Name": "PLY_COORDS", "Value.$": "$.envVars.PLY_COORDS"},
            {"Name": "SPZ_COORDS", "Value.$": "$.envVars.SPZ_COORDS"},
            {"Name": "SOG_COORDS", "Value.$": "$.envVars.SOG_COORDS"},
            {"Name": "USDZ_COORDS", "Value.$": "$.envVars.USDZ_COORDS"},
            {"Name": "CROP_OUTPUT_BOUNDS", "Value.$": "$.envVars.CROP_OUTPUT_BOUNDS"},
            {"Name": "CROP_MODE", "Value.$": "$.envVars.CROP_MODE"},
            {"Name": "CLEAN_SPLAT", "Value.$": "$.envVars.CLEAN_SPLAT"},
            {"Name": "SPHERICAL_CAMERA", "Value.$": "$.envVars.SPHERICAL_CAMERA"},
            {"Name": "SPHERICAL_CUBE_FACES_TO_REMOVE", "Value.$": "$.envVars.SPHERICAL_CUBE_FACES_TO_REMOVE"},
            {"Name": "REMOVE_BACKGROUND", "Value.$": "$.envVars.REMOVE_BACKGROUND"},
            {"Name": "BACKGROUND_REMOVAL_MODEL", "Value.$": "$.envVars.BACKGROUND_REMOVAL_MODEL"},
            {"Name": "MASK_THRESHOLD", "Value.$": "$.envVars.MASK_THRESHOLD"},
            {"Name": "REMOVE_OBJECT", "Value.$": "$.envVars.REMOVE_OBJECT"},
            {"Name": "OBJECT_REMOVAL_ACTION", "Value.$": "$.envVars.OBJECT_REMOVAL_ACTION"},
            {"Name": "OBJECT_REMOVAL_OBJECTS", "Value.$": "$.envVars.OBJECT_REMOVAL_OBJECTS"},
            {"Name": "PRESERVE_SCENE_SCALE", "Value.$": "$.envVars.PRESERVE_SCENE_SCALE"},
            {"Name": "DDB_TABLE_NAME", "Value.$": "$.stateMachine.ddbTableName"},
            {"Name": "AWS_DEFAULT_REGION", "Value.$": "$.stateMachine.awsRegion"}
          ]
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "States.TaskFailed"
          ],
          "IntervalSeconds": 60,
          "MaxAttempts": 0,
          "BackoffRate": 2
        },
        {
          "ErrorEquals": [
            "States.Timeout"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 0,
          "BackoffRate": 1
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "ErrorHandler"
        }
      ],
      "Next": "SuccessHandler"
    },
    "InvokeSageMakerWorkflow": {
      "Type": "Task",
      "InputPath": "$",
      "ResultPath": "$.invokeWorkflow",
      "Resource": "arn:aws:states:::sagemaker:createTrainingJob.sync",
      "Parameters": {
        "TrainingJobName.$": "$.envVars.UUID",
        "ResourceConfig": {
          "InstanceCount.$": "$.stateMachine.instanceCount",
          "InstanceType.$": "$.envVars.INSTANCE_TYPE",
          "VolumeSizeInGB.$": "$.stateMachine.volumeSizeInGB"
        },
        "AlgorithmSpecification": {
          "TrainingImage.$": "$.stateMachine.ecrImageArn",
          "TrainingInputMode": "File",
          "ContainerEntrypoint.$": "$.stateMachine.containerEntryPoint",
          "ContainerArguments.$": "$.stateMachine.containerArgs"
        },
        "OutputDataConfig": {
          "S3OutputPath.$": "$.envVars.S3_OUTPUT"
        },
        "StoppingCondition": {
          "MaxRuntimeInSeconds.$": "$.stateMachine.timeout"
        },
        "RoleArn.$": "$.stateMachine.containerRoleArn",
        "InputDataConfig": [
          {
            "ChannelName.$": "$.envVars.DATA_CHANNEL",
            "DataSource": {
              "S3DataSource": {
                "S3DataType": "S3Prefix",
                "S3Uri.$": "$.envVars.S3_INPUT",
                "S3DataDistributionType": "FullyReplicated"
              }
            }
          },
          {
            "ChannelName": "model",
            "DataSource": {
              "S3DataSource": {
                "S3DataType": "S3Prefix",
                "S3Uri.$": "$.envVars.MODEL_INPUT",
                "S3DataDistributionType": "FullyReplicated"
              }
            }
          }
        ],
        "Environment": {
          "INSTANCE_TYPE.$": "$.envVars.INSTANCE_TYPE",
          "UUID.$": "$.envVars.UUID",
          "DATA_CHANNEL.$": "$.envVars.DATA_CHANNEL",
          "MODEL_INPUT.$": "$.envVars.MODEL_INPUT",
          "S3_INPUT.$": "$.envVars.S3_INPUT",
          "S3_OUTPUT.$": "$.envVars.S3_OUTPUT",
          "FILENAME.$": "$.envVars.FILENAME",
          "USE_SPOT_INSTANCE.$": "$.envVars.USE_SPOT_INSTANCE",
          "COMPUTE_TYPE.$": "$.envVars.COMPUTE_TYPE",
          "LOG_VERBOSITY.$": "$.envVars.LOG_VERBOSITY",
          "MAX_NUM_IMAGES.$": "$.envVars.MAX_NUM_IMAGES",
          "FILTER_BLURRY_IMAGES.$": "$.envVars.FILTER_BLURRY_IMAGES",
          "RUN_RECON.$": "$.envVars.RUN_RECON",
          "RECON_SOFTWARE_NAME.$": "$.envVars.RECON_SOFTWARE_NAME",
          "USE_POSE_PRIOR_COLMAP_MODEL_FILES.$": "$.envVars.USE_POSE_PRIOR_COLMAP_MODEL_FILES",
          "USE_POSE_PRIOR_TRANSFORM_JSON.$": "$.envVars.USE_POSE_PRIOR_TRANSFORM_JSON",
          "SOURCE_COORD_NAME.$": "$.envVars.SOURCE_COORD_NAME",
          "POSE_IS_WORLD_TO_CAM.$": "$.envVars.POSE_IS_WORLD_TO_CAM",
          "ENABLE_ENHANCED_FEATURE_EXTRACTION.$": "$.envVars.ENABLE_ENHANCED_FEATURE_EXTRACTION",
          "MATCHING_METHOD.$": "$.envVars.MATCHING_METHOD",
          "ENABLE_FL_HEURISTIC.$": "$.envVars.ENABLE_FL_HEURISTIC",
          "FL_HEURISTIC_VALUE.$": "$.envVars.FL_HEURISTIC_VALUE",
          "RUN_TRAIN.$": "$.envVars.RUN_TRAIN",
          "MODEL.$": "$.envVars.MODEL",
          "MAX_STEPS.$": "$.envVars.MAX_STEPS",
          "THREED_ISP.$": "$.envVars.THREED_ISP",
          "ENABLE_SPZ.$": "$.envVars.ENABLE_SPZ",
          "ENABLE_SOG.$": "$.envVars.ENABLE_SOG",
          "ENABLE_USDZ.$": "$.envVars.ENABLE_USDZ",
          "PLY_COORDS.$": "$.envVars.PLY_COORDS",
          "SPZ_COORDS.$": "$.envVars.SPZ_COORDS",
          "SOG_COORDS.$": "$.envVars.SOG_COORDS",
          "USDZ_COORDS.$": "$.envVars.USDZ_COORDS",
          "CROP_OUTPUT_BOUNDS.$": "$.envVars.CROP_OUTPUT_BOUNDS",
          "CROP_MODE.$": "$.envVars.CROP_MODE",
          "CLEAN_SPLAT.$": "$.envVars.CLEAN_SPLAT",
          "SPHERICAL_CAMERA.$": "$.envVars.SPHERICAL_CAMERA",
          "SPHERICAL_CUBE_FACES_TO_REMOVE.$": "$.envVars.SPHERICAL_CUBE_FACES_TO_REMOVE",
          "REMOVE_BACKGROUND.$": "$.envVars.REMOVE_BACKGROUND",
          "BACKGROUND_REMOVAL_MODEL.$": "$.envVars.BACKGROUND_REMOVAL_MODEL",
          "MASK_THRESHOLD.$": "$.envVars.MASK_THRESHOLD",
          "REMOVE_OBJECT.$": "$.envVars.REMOVE_OBJECT",
          "OBJECT_REMOVAL_ACTION.$": "$.envVars.OBJECT_REMOVAL_ACTION",
          "OBJECT_REMOVAL_OBJECTS.$": "$.envVars.OBJECT_REMOVAL_OBJECTS",
          "PRESERVE_SCENE_SCALE.$": "$.envVars.PRESERVE_SCENE_SCALE",
          "DDB_TABLE_NAME.$": "$.stateMachine.ddbTableName",
          "AWS_DEFAULT_REGION.$": "$.stateMachine.awsRegion"
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "SageMaker.JobFailed"
          ],
          "IntervalSeconds": 60,
          "MaxAttempts": 3,
          "BackoffRate": 2
        },
        {
          "ErrorEquals": [
            "SageMaker.ResourceLimitExceededException"
          ],
          "IntervalSeconds": 60,
          "MaxAttempts": 5,
          "BackoffRate": 1
        },
        {
          "ErrorEquals": [
            "States.Timeout"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 5,
          "BackoffRate": 1
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "ErrorHandler"
        }
      ],
      "Next": "SuccessHandler"
    },
    "ErrorHandler": {
      "Type": "Pass",
      "Parameters": {
        "stateMachine.$": "$.stateMachine",
        "envVars.$": "$.envVars",
        "sns.$": "$.sns",
        "error.$": "$.error",
        "status": "FAILED"
      },
      "Next": "Complete"
    },
    "SuccessHandler": {
      "Type": "Pass",
      "Parameters": {
        "stateMachine.$": "$.stateMachine",
        "envVars.$": "$.envVars",
        "sns.$": "$.sns",
        "status": "SUCCESS",
        "result.$": "$.invokeWorkflow"
      },
      "Next": "Complete"
    },
    "FailState": {
      "Type": "Pass",
      "Parameters": {
        "stateMachine.$": "$.stateMachine",
        "envVars.$": "$.envVars",
        "sns.$": "$.sns",
        "status": "FAILED",
        "error": {
          "Error": "ConfigurationError",
          "Cause": "Invalid status code in configuration"
        }
      },
      "Next": "Complete"
    },
    "Complete": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "InputPath": "$",
      "ResultPath": "$.complete",
      "Parameters": {
        "Payload.$": "$",
        "FunctionName.$": "$.stateMachine.completeLambdaName"
      },
      "End": true
    }
  }
}
